# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# NextAuth — generate a random secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3000

# Domo Programmatic Embed credentials
DOMO_CLIENT_ID=fc718710-d8bf-47aa-b870-e32b9846182d
DOMO_CLIENT_SECRET=replace_with_your_domo_client_secret

# Domo instance hostname
DOMO_INSTANCE=richeymay.domo.com
