# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (never commit .env — it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
#
# LOCAL (SQLite — no extra setup needed):
DATABASE_URL="file:./prisma/dev.db"
#
# PRODUCTION on Vercel (Postgres — uncomment and fill in, then change
# provider = "postgresql" in prisma/schema.prisma):
# DATABASE_URL="******HOST/DATABASE?sslmode=require"
#
# Free Postgres options:
#   • Neon      https://neon.tech   (recommended with Vercel)
#   • Vercel Postgres  (add from your Vercel project dashboard)

# ── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Generate a secure random secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
# On Vercel, set NEXTAUTH_URL to your deployment URL, e.g.:
# NEXTAUTH_URL=https://your-app.vercel.app

# ── DOMO PROGRAMMATIC EMBED ───────────────────────────────────────────────────
DOMO_CLIENT_ID=fc718710-d8bf-47aa-b870-e32b9846182d
# IMPORTANT: keep your Client Secret out of source code — only put it here
DOMO_CLIENT_SECRET=replace_with_your_domo_client_secret
DOMO_INSTANCE=richeymay.domo.com
